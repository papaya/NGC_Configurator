#Modulbox																									
RESET_HW																									
																									
# the SCS should emulate button/enc functions in main page
SCS soft1_button_emu_id=2000 \
    soft2_button_emu_id=2001 \
    soft3_button_emu_id=2002 \
    soft4_button_emu_id=2003 \
    shift_button_emu_id=2004 \
    enc_emu_id=2000







# try f0 01 00 40 41 42 f7
# -> expect @AB at x=1/y=1
EVENT_RECEIVER id=1 \
               type=SysEx stream="0xf0 0x01 ^cursor ^txt" \
	       lcd_pos=1:1:4




#LCD "%C@(1:1:4)&bBANK 1"

#LCD "@(1:10:7) &tCC"

# Controlled from SCS buttons at J10 in main page
EVENT_BUTTON id=2000  type=Meta   meta=SetBank   button_mode=OnOnly range=1:1  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON id=2001  type=Meta   meta=SetBank   button_mode=OnOnly range=2:2  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON id=2002  type=Meta   meta=SetBank   button_mode=OnOnly range=3:3  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON id=2003  type=Meta   meta=SetBank   button_mode=OnOnly range=4:4  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON id=2004  type=Meta   meta=EncFast:4 button_mode=OnOff  range=0:2

#EVENT_BUTTON id=  1  hw_id =  1  fwd_id=LED:1  fwd_to_lcd=1  radio_group=1  type=Meta  meta=SetBank button_mode=OnOnly  range=  1:1
# bank
EVENT_BUTTON hw_id=82 fwd_id=LED:23 radio_group=1 type=Meta   meta=SetBank   button_mode=OnOnly range=1:1  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON hw_id=84 fwd_id=LED:21 radio_group=1 type=Meta   meta=SetBank   button_mode=OnOnly range=2:2  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON hw_id=86 fwd_id=LED:19 radio_group=1 type=Meta   meta=SetBank   button_mode=OnOnly range=3:3  lcd_pos=1:7:5 label="&b%q"
EVENT_BUTTON hw_id=88 fwd_id=LED:17 radio_group=1 type=Meta   meta=SetBank   button_mode=OnOnly range=4:4  lcd_pos=1:7:5 label="&b%q"

# the SCS encoder at J10 just increments/decrements the bank
# redundant function - could be changed in future
EVENT_ENC    id=2000  type=Meta   meta=SetBank   range=1:14

# the purpose of this EVENT item is to print the bank whenever the LCD is refreshed (e.g. after startup or bank change)
LCD "@(1:18:4) &tBANK"
EVENT_LED id=2000 fwd_to_lcd=1 lcd_pos=1:7:5 label="&b%q"
																									
#encoder_hardware_configuration																									
ENC n= 15 sr= 6 pins=5:4 type=non_detented																									
ENC n= 16 sr= 6 pins=7:6 type=non_detented																									
ENC n= 1 sr= 1 pins=1:0 type=non_detented																									
ENC n= 2 sr= 1 pins=3:2 type=non_detented																									
ENC n= 3 sr= 1 pins=5:4 type=non_detented																									
ENC n= 4 sr= 1 pins=7:6 type=non_detented																									
ENC n= 5 sr= 2 pins=1:0 type=non_detented																									
ENC n= 6 sr= 2 pins=3:2 type=non_detented																									
ENC n= 7 sr= 2 pins=5:4 type=non_detented																									
ENC n= 8 sr= 2 pins=7:6 type=non_detented																									
ENC n= 9 sr= 5 pins=1:0 type=non_detented																									
ENC n= 10 sr= 5 pins=3:2 type=non_detented																									
ENC n= 11 sr= 5 pins=5:4 type=non_detented																									
ENC n= 12 sr= 5 pins=7:6 type=non_detented																									
ENC n= 13 sr= 6 pins=1:0 type=non_detented																									
ENC n= 14 sr= 6 pins=3:2 type=non_detented																									
																									
#ainser_hardware_configuration																									
aINSER n= 1 enabled=1 muxed=1 cs=0 resolution=7bit																									
aINSER n= 2 enabled=0 muxed=1 cs=1 resolution=7bit				



# LED will change brightness (v) based on value (hue statically defined)																
EVENT_RGBLED	id=	129			dimmed=1 	range=	0:10 								
EVENT_RGBLED	id=	130			dimmed=1  range=	0:10 
EVENT_RGBLED	id=	131			dimmed=1 	range=	0:10  
